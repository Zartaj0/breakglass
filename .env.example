# ── Dashboard ──────────────────────────────────────────────────────────────────
PORT=3030
HOST=127.0.0.1
BREAKGLASS_MONITOR_POLL_MS=30000
BREAKGLASS_MONITOR_INCIDENT_REUSE_MS=300000

# ── Safe Source ─────────────────────────────────────────────────────────────────
# Safes are added via the dashboard UI (POST /api/safes). These vars are used as
# defaults when running the CLI pipeline directly.
SAFE_PENDING_SOURCE=live
SAFE_NETWORK=base-sepolia
SAFE_ADDRESS=0x7A5b0F2a641fD36f8450eD8D3B4E8A1D6339a4F5
SAFE_API_KEY=
SAFE_API_BASE_URL=
SAFE_API_CHAIN=basesep
SAFE_PENDING_LIMIT=20
WATCHER_FIXTURE_PATH=apps/watcher/fixtures/pending-transactions.json
# ── AI Investigation / Explanation ─────────────────────────────────────────────
# BreakGlass will try providers in order: Gemini -> Anthropic -> Nvidia ->
# Mistral -> OpenRouter. Configure as many as you want; the first healthy one
# will be used. Ollama remains available for the legacy 3-sentence brief helper.
AI_BRIEF_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
NVIDIA=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
MISTRAL=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER=
OPENROUTER_MODELS=google/gemma-3-27b-it:free
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:4b
AI_BRIEF_TIMEOUT_MS=20000

# ── Incident Policies ───────────────────────────────────────────────────────────
# suspicious_approval
BREAKGLASS_ALLOWED_SPENDERS=0x1111111111111111111111111111111111111111
BREAKGLASS_APPROVAL_THRESHOLD=100000000000000000000000
# ownership_change
BREAKGLASS_ALLOWED_OWNERS=
BREAKGLASS_MIN_THRESHOLD=2
# module_enablement
BREAKGLASS_ALLOWED_MODULES=
# large_transfer
BREAKGLASS_MAX_ETH_TRANSFER=1000000000000000000
BREAKGLASS_MAX_TOKEN_TRANSFER=10000000000000000000000
BREAKGLASS_ALLOWED_RECIPIENTS=
# unknown_transaction
BREAKGLASS_ENABLE_UNKNOWN_TRANSACTION=true
BREAKGLASS_UNKNOWN_TX_MIN_DATA_BYTES=4

BREAKGLASS_AUTO_EXECUTE_FIRST_STEP=false
KEEPERHUB_MODE=local
KEEPERHUB_WEBHOOK_URL=
KEEPERHUB_API_KEY=
KEEPERHUB_INCLUDE_FULL_PAYLOAD=false
KEEPERHUB_TIMEOUT_MS=15000
GENSYN_AXL_MODE=disabled
GENSYN_AXL_API_BASE_URL=http://127.0.0.1:9003
GENSYN_AXL_PEER_IDS=
GENSYN_AXL_SERVICE=breakglass-review
GENSYN_AXL_TIMEOUT_MS=7000
GENSYN_AXL_MIN_APPROVALS=1
GENSYN_AXL_REQUIRE_QUORUM_FOR_EXECUTION=false
GENSYN_AXL_ROUTER_URL=http://127.0.0.1:9003
GENSYN_AXL_ROUTER_HOST=127.0.0.1
GENSYN_AXL_ROUTER_PORT=9003
GENSYN_AXL_REVIEWER_HOST=127.0.0.1
GENSYN_AXL_REVIEWER_PORT=7100
GENSYN_AXL_REVIEWER_PATH=/mcp
GENSYN_AXL_REVIEWER_LABEL=breakglass-reviewer-a
GENSYN_AXL_REGISTER_WITH_ROUTER=true
SAFE_EXECUTION_MODE=dry-run
SAFE_RPC_URL=
SAFE_OWNER_PRIVATE_KEY=
SAFE_CONFIRMING_OWNER_KEYS=
SAFE_EXECUTE_WHEN_READY=false
SAFE_TX_SERVICE_URL=
BREAKGLASS_ORIGIN=BreakGlass
BREAKGLASS_DEMO_TOKEN_ADDRESS=0x4200000000000000000000000000000000000006
BREAKGLASS_DEMO_SPENDER=0xDeaDbeEF00000000000000000000000000000000
BREAKGLASS_DEMO_APPROVAL_AMOUNT=115792089237316195423570985008687907853269984665640564039457584007913129639935
BREAKGLASS_RECEIPT_STORAGE=file
BREAKGLASS_ARTIFACT_DIR=artifacts
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_PRIVATE_KEY=
